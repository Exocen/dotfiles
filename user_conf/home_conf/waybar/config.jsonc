// =============================================================================
//
// Waybar configuration
//
// Configuration reference: https://github.com/Alexays/Waybar/wiki/Configuration
//
// =============================================================================

[{
    "output": "DP-1",
    "layer": "top",
    "position": "top",
    "height": 30,

    "modules-left": [
        "sway/workspaces",
        "sway/mode"
    ],
    "modules-center":[
        "pulseaudio",
        "mpd",
        "custom/bluetooth-battery"
    ],
    "modules-right": [
        "tray",
        "clock#time",
        "custom/capslock-status"
    ],
    "include": [
        "~/.config/waybar/module-config.jsonc"
    ]
},
{
    "output": "!DP-1",
    "layer": "top",
    "position": "top",
    "height": 30,

    "modules-left": [
        "sway/workspaces",
        "sway/mode"
    ],
    "modules-center":[
    ],
    "modules-right": [
        "custom/vpn-status",
        "network",
        "disk#root",
        "disk#home",
        "custom/iostat",
        "memory",
        "cpu",
        "temperature#gpu",
        "temperature#cpu",
        "custom/pacman-status",
        "pulseaudio",
        "custom/bluetooth-battery",
        "mpd",
        "tray",
        "clock#date",
        "clock#time",
        "custom/capslock-status"
    ],
    "include": [
        "~/.config/waybar/module-config.jsonc"
    ]
}]
